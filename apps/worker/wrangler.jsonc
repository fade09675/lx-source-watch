{
  "name": "lx-source-watch",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },
  "routes": [{ "pattern": "dash.dpdns.org", "custom_domain": true }],
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "kv_namespaces": [
    {
      "binding": "SNAPSHOT",
      "id": "b03922f750664b2babae29ee524c7936"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lx-source-watch",
      "database_id": "480ae090-90e3-4b14-8415-ef7a33d7d0a5",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "SITE_NAME": "LX 音源监测",
    "PUBLIC_ORIGIN": "https://dash.dpdns.org",
    "CF_ACCOUNT_ID": "8e8c755370e9a2bf44146edf108f3e39",
    "D1_ID": "480ae090-90e3-4b14-8415-ef7a33d7d0a5"
  }
}
